# Copie para .env.local e preencha só se quiser o assistente de IA.
# Sem esta chave o sistema funciona normalmente, sem o assistente.
ANTHROPIC_API_KEY=
# Modelo usado pelo assistente (opcional)
# MIRA_AI_MODEL=claude-sonnet-5-5
# Pasta do banco SQLite (opcional; padrão: ./data)
# MIRA_DATA_DIR=./data
# Instância atrás de HTTPS: o cookie de sessão passa a ser Secure (opcional)
# MIRA_HTTPS=1
# Só com um proxy confiável na frente: usa o X-Forwarded-For para contar tentativas de login por endereço (opcional)
# MIRA_TRUST_PROXY=1
